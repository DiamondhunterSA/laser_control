02347         {\cf17 def }get_raw_spectrum_with_metadata(self, list_raw_spectra: list[list[float]], list_timestamp: list[int], buffer_size: int) -> int:\par
02348             {\cf22 """!}\par
02349 {\cf22             Returns spectra with metadata information. For older devices such as FX/HDX, read a maximum of 15}\par
02350 {\cf22             spectra from the data buffer. This function requires that both back to back scans and data buffer}\par
02351 {\cf22             be enabled. See "set_data_buffer_enable()" and "set_number_of_backtoback_scans()". For newer devices}\par
02352 {\cf22             such as Ocean SR2, you can call this function right away. See device manual if this command is supported.}\par
02353 {\cf22             @param list_raw_spectra The spectra output buffer.}\par
02354 {\cf22             @param list_timestamp   The timestamp output buffer of each spectra.}\par
02355 {\cf22             @param buffer_size      The buffer array size (maximum is 15).}\par
02356 {\cf22             @return The number of spectra read. It can be zero.}\par
02357 {\cf22             """}\par
02358             buffer = (POINTER(c_double) * buffer_size)()\par
02359             {\cf19 for} x {\cf19 in} range(buffer_size):\par
02360                 buffer[x] = (c_double * self.device.pixel_count_formatted)()\par
02361 \par
02362             timestamp    = (c_longlong * buffer_size)(0)\par
02363             err_cp       = (c_long * 1)(0)\par
02364             spectraCount = self.device.oceandirect.odapi_get_raw_spectrum_with_metadata(self.device.device_id, err_cp, buffer, buffer_size,\par
02365                                                                                         self.device.pixel_count_formatted, timestamp, buffer_size)\par
02366 \par
02367             {\cf19 if} err_cp[0] != 0:\par
02368                 error_msg = self.device.decode_error(err_cp[0], {\cf22 "get_raw_spectrum_with_metadata"})\par
02369                 {\cf19 raise} OceanDirectError(err_cp[0], error_msg)\par
02370 \par
02371             {\cf19 for} x {\cf19 in} range(spectraCount):\par
02372                 spectra = [{\cf18 None}] * self.device.pixel_count_formatted\par
02373 \par
02374                 {\cf20 #Convert c-types into python. There might be a better way to do this.}\par
02375                 {\cf19 for} y {\cf19 in} range(self.device.pixel_count_formatted):\par
02376                     spectra[y] = buffer[x][y]\par
02377                 \par
02378                 list_raw_spectra.append(spectra)\par
02379                 {\cf20 #list_raw_spectra.append(buffer[x])}\par
02380                 list_timestamp.append(timestamp[x])\par
02381             {\cf19 return} spectraCount\par
